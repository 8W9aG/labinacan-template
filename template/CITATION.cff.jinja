# How to cite {{ name }}. GitHub shows it as "Cite this repository".
cff-version: 1.2.0
message: >-
  If you use {{ name }}, please cite it as below.
title: "{{ name }}"
type: software
authors:
  - name: "{{ author }}"
repository-code: "https://github.com/{{ repo }}"
license: MIT
abstract: >-
  {{ description }}
