  "teal": ["f0fdfa", "ccfbf1", "99f6e4", "5eead4", "2dd4bf", "14b8a6", "0d9488", "0f766e", "115e59", "134e4a", "042f2e"],
  "sky": ["f0f9ff", "e0f2fe", "bae6fd", "7dd3fc", "38bdf8", "0ea5e9", "0284c7", "0369a1", "075985", "0c4a6e", "082f49"],
  "indigo": ["eef2ff", "e0e7ff", "c7d2fe", "a5b4fc", "818cf8", "6366f1", "4f46e5", "4338ca", "3730a3", "312e81", "1e1b4b"],
  "emerald": ["ecfdf5", "d1fae5", "a7f3d0", "6ee7b7", "34d399", "10b981", "059669", "047857", "065f46", "064e3b", "022c22"],
  "rose": ["fff1f2", "ffe4e6", "fecdd3", "fda4af", "fb7185", "f43f5e", "e11d48", "be123c", "9f1239", "881337", "4c0519"],
  "amber": ["fffbeb", "fef3c7", "fde68a", "fcd34d", "fbbf24", "f59e0b", "d97706", "b45309", "92400e", "78350f", "451a03"],
} -%}
{%- set shades = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] -%}
[project]
name = "{{ slug }}"
dynamic = ["version"]
description = "{{ description }}"
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "{{ author }}" }]
maintainers = [{ name = "{{ name }}", email = "{{ email }}" }]
requires-python = ">=3.11"
classifiers = [
{%- if not pypi %}
    "Private :: Do Not Upload",  # a local project: PyPI refuses an upload
{%- endif %}
    "Programming Language :: Python :: 3",
]
dependencies = [
    # The site, papers, posts and brand, from PyPI (8W9aG/labinacan). `copier update`
    # moves this pin when the template moves to a new release.
    "labinacan[r2,pii]==0.1.1",
]

[project.urls]
Homepage = "{{ site_url }}"
Repository = "https://github.com/{{ repo }}"

[dependency-groups]
dev = [
    "diff-cover>=9.2",
    "interrogate>=1.7.0",
    "mcp>=2.0",
    "mypy>=1.13",
    "mutmut==3.8.1",  # make mutation (scripts/mutation.py); pinned, as its internals are used
    "pagefind[bin]>=1.3.0",
    "pymarkdownlnt>=0.9.41",
    "pytest>=8.0.0",
    "pytest-cov>=6.0",
    "pytest-mock>=3.12.0",
    "pytest-timeout>=2.3.0",
    "pytest-xdist>=3.8.0",
    "ruff>=0.17.4",
    "shellcheck-py>=0.11.0.1",
    "vulture>=2.16",
    "yamllint>=1.38.0",
]


[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.version]
path = "{{ package }}/__init__.py"

[tool.hatch.build.targets.wheel]
packages = ["{{ package }}"]

[tool.labinacan]
# The project's values (labinacan.config), from the answers to copier's questions.
name = "{{ name }}"
package = "{{ package }}"
env_prefix = "{{ env_prefix }}"
linear_team = "{{ linear_team }}"
maintainer = "{{ maintainer }}"
hf_dataset = "{{ hf_dataset }}"
generated = []
data_only = []
automatic_issue_workflows = []

[tool.labinacan.brand]
# The brand: a can on the 3 x 3 grid of the mark. Its lid row is full, its label
# column is full and its sides are two thirds full, so the shape reads without colour.
folder = "brand"  # the brand's files, inside the package
tile = "{{ tile }}"  # the mark's tile
ink = { light = "#0F172A", dark = "#F8FAFC" }  # the wordmark
colours = { lid = "{{ lid }}", side = "{{ side }}", label = "{{ label }}" }
cells = [
  [0, 0, 3, "lid"], [1, 0, 3, "lid"], [2, 0, 3, "lid"],
  [0, 1, 2, "side"], [1, 1, 3, "label"], [2, 1, 2, "side"],
  [0, 2, 2, "side"], [1, 2, 3, "label"], [2, 2, 2, "side"],
]
# The site's links and highlights: Tailwind's {{ accent }} shades.
accent = { {% for s in shades %}{{ s }} = "#{{ palettes[accent][loop.index0] }}"{% if not loop.last %}, {% endif %}{% endfor %} }

[tool.pytest.ini_options]
# The package's docstring examples run too. tests/test_doctests.py checks that each public
# function has one.
testpaths = ["tests", "{{ package }}"]
addopts = "-ra --doctest-modules"
doctest_optionflags = ["NORMALIZE_WHITESPACE", "ELLIPSIS"]
# A hang fails within three minutes, dumping every thread's stack and naming the test.
timeout = 180
timeout_method = "thread"

[tool.mypy]
# Type checks, ratcheted in module by module. Only the paths in `files` are checked, strictly.
files = ["{{ package }}/__init__.py"]
plugins = ["pydantic.mypy"]
strict = true
python_version = "3.12"
follow_imports = "silent"
ignore_missing_imports = true

[tool.interrogate]
# Docstring coverage of the package and scripts, private functions included. Raise
# fail-under as coverage rises, to 100, never lower it.
fail-under = 94
ignore-magic = true
ignore-init-method = true
ignore-private = false
ignore-semiprivate = false
ignore-module = false

[tool.mutmut]
# Mutation testing (`make mutation`). source_paths copies the package into mutants/, so the
# tests can import it. Without BASE, only_mutate is the code that a project's checks rest on.
# A new project has none yet: list each file here as it comes, with its tests below.
source_paths = ["{{ package }}"]
only_mutate = []
also_copy = [".github/workflows", "scripts"]
pytest_add_cli_args = ["-p", "no:cacheprovider", "-o", "addopts=-ra", "-q"]
timeout_constant = 10
pytest_add_cli_args_test_selection = []
