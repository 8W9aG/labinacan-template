"""The project's DOI link, which scripts/submit_paper.py puts in a paper's alphaXiv submission."""

import importlib
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
submit_paper = importlib.import_module("submit_paper")


def test_a_project_with_a_doi_links_it(tmp_path, monkeypatch):
    (tmp_path / "CITATION.cff").write_text("title: T\ndoi: 10.5281/zenodo.1\n", encoding="utf-8")
    monkeypatch.setattr(submit_paper, "ROOT", tmp_path)
    assert submit_paper.doi_link() == ["https://doi.org/10.5281/zenodo.1"]


def test_a_project_without_a_doi_has_no_doi_link(tmp_path, monkeypatch):
    # A project that Zenodo doesn't archive has no DOI in its CITATION.cff.
    (tmp_path / "CITATION.cff").write_text("title: T\n", encoding="utf-8")
    monkeypatch.setattr(submit_paper, "ROOT", tmp_path)
    assert submit_paper.doi_link() == []


def test_a_project_without_a_root_citation_file_has_no_doi_link(tmp_path, monkeypatch):
    monkeypatch.setattr(submit_paper, "ROOT", tmp_path)
    assert submit_paper.doi_link() == []
